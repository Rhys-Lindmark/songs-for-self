    "data:upload": "node scripts/build-upload-lookup.mjs",
    "data:other-audit": "node scripts/report-other-genres.mjs",
    "data:singleton-queue": "node scripts/report-genre-singleton-queue.mjs",
    "data:genre-evidence-gaps": "node scripts/report-genre-evidence-gaps.mjs",
    "data:manifest": "node scripts/build-dataset-manifest.mjs",
    "benchmark:playlist-import": "node scripts/benchmark-playlist-import.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:responsive": "node scripts/responsive-smoke.mjs",
    "test:accessibility": "node scripts/accessibility-smoke.mjs",
    "test:spotify-browser": "node scripts/spotify-browser-smoke.mjs",
    "test:spotify-preview-browser": "node scripts/spotify-public-preview-browser-smoke.mjs",
    "test:spotify-copied-browser": "node scripts/spotify-copied-tracks-browser-smoke.mjs",
    "test:spotify-copied-resume-browser": "node scripts/spotify-copied-import-resume-browser-smoke.mjs",
