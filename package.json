{
  "name": "songs-for-self",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/clean-build-output.mjs && vinext build && node scripts/mirror-framework-assets.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "data:enrich": "node scripts/enrich-wikidata.mjs",
    "data:musicbrainz": "node scripts/enrich-musicbrainz.mjs",
    "data:albums-batch": "node scripts/enrich-musicbrainz-albums-batch.mjs",
    "data:artist-names": "node scripts/enrich-artist-names.mjs",
    "data:artist-profiles": "node scripts/enrich-wikidata-artist-profiles.mjs",
    "data:artist-images": "node scripts/enrich-wikidata-artist-images.mjs",
    "data:recordings": "node scripts/enrich-musicbrainz-recordings.mjs",
    "data:artists": "node scripts/enrich-musicbrainz-artists.mjs",
    "data:artist-genres": "node scripts/enrich-musicbrainz-artist-genres.mjs",
    "data:release-group-genres": "node scripts/enrich-musicbrainz-release-group-genres.mjs",
    "data:release-group-genre-review": "node scripts/report-musicbrainz-release-group-genre-review.mjs",
    "data:discogs-release-genres": "node scripts/enrich-discogs-release-genres.mjs",
    "data:discogs-release-genre-review": "node scripts/report-discogs-release-genre-review.mjs",
    "data:artist-genre-review": "node scripts/report-musicbrainz-genre-review.mjs",
    "data:wikidata-name-genres": "node scripts/enrich-wikidata-name-genres.mjs",
    "data:wikidata-genre-review": "node scripts/report-wikidata-genre-review.mjs",
    "data:areas": "node scripts/enrich-wikidata-musicbrainz-areas.mjs",
    "data:v2": "node scripts/apply-v2-enrichment.mjs",
    "data:genre-overrides": "node scripts/apply-genre-overrides.mjs",
    "data:geography-overrides": "node scripts/apply-geography-overrides.mjs",
    "data:us-state-cache": "node scripts/build-us-state-coordinate-cache.mjs",
    "data:us-state-regions": "node scripts/apply-us-state-regions.mjs",
    "data:viz": "node scripts/build-viz-data.mjs",
    "data:genre-space": "node scripts/build-genre-space-data.mjs",
    "data:every-noise-artists": "node scripts/enrich-every-noise-artist-memberships.mjs",
