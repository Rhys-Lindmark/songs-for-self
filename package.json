    "test:progressive-layers-browser": "node scripts/playlist-progressive-layers-browser-smoke.mjs",
    "test:album-explorer-browser": "node scripts/album-explorer-browser-smoke.mjs",
    "test:timeline-artwork-browser": "node scripts/timeline-artwork-browser-smoke.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "check:types": "tsc --noEmit --incremental false",
    "check": "npm test && npm run check:types",
    "deploy": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
