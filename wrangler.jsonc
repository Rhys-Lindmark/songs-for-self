{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songs-for-self",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
